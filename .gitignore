```gitignore
# Dependencies
node_modules/

# Environment variables and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Keep the example environment file tracked
!.env.example

# Build outputs
.next/
out/
dist/
build/

# Vite
.vite/

# Deployment
.vercel/
.netlify/

# Testing and coverage
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Cache
.cache/
.parcel-cache/
.turbo/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
